# Copy to .env (cp .env.example .env). Everything here is optional for local development:
# without a .env the API uses the local Docker MongoDB from appsettings.Development.json.

# MongoDB (local database: docker compose up -d)
ConnectionStrings__DbConnection=mongodb://localhost:27017
ConnectionStrings__DatabaseName=test

# Google Maps (geocoding and distance endpoints only)
GoogleMaps__ApiKey=
